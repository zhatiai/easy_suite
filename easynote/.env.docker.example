# Copy to .env. Use your real HTTPS origin, without a trailing slash.
PUBLIC_ORIGIN=https://notes.example.com
EASYNOTE_PORT=8791
EASYNOTE_DATA_DIR=/var/lib/easynote/data

# Enable only behind a trusted reverse proxy that overwrites X-Real-IP.
TRUST_PROXY=true
ALLOW_LOCAL_HTTP=false

# Local smoke test (browser access only on the server itself):
# PUBLIC_ORIGIN=http://127.0.0.1:8791
# TRUST_PROXY=false
# ALLOW_LOCAL_HTTP=true
